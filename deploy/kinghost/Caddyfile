{
  email {$LETSENCRYPT_EMAIL}
  admin off
}
{$DOMAIN} {
  redir https://{$WWW_DOMAIN}{uri} permanent
}
{$WWW_DOMAIN} {
  encode zstd gzip
  reverse_proxy web:80
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    -Server
  }
  log {
    output stdout
    format console
  }
}
