# DATABASE_PORT=5432
# DATABASE_NAME=nh_plataforma
# DATABASE_USERNAME=nh_plataforma
# DATABASE_PASSWORD=

# Para um serviço criado manualmente, também é possível usar:
# DATABASE_URL=jdbc:postgresql://HOST:5432/BANCO
# DATABASE_USERNAME=USUARIO
# DATABASE_PASSWORD=SENHA


